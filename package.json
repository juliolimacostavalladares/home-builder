{
  "name": "home-builder-cad-api",
  "version": "1.0.0",
  "description": "Conversão CAD para o editor original furnishup/blueprint3d integrado",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/*.test.js",
    "build:blueprint": "cd vendor/blueprint3d && npm ci --legacy-peer-deps --ignore-scripts --no-audit --no-fund && node_modules/.bin/grunt"
  },
  "keywords": [
    "cad",
    "dwg",
    "dxf",
    "svg",
    "png",
    "dwg2dxf",
    "blueprint"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "dxf-parser": "^1.1.2",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "nasjidwg": "^0.18.0",
    "sharp": "^0.33.5"
  }
}
